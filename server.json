{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Evalogical-Inc/devready",
  "title": "DevReady",
  "description": "Read-only check that a machine meets a project's declared tool and runtime versions.",
  "repository": {
    "url": "https://github.com/Evalogical-Inc/devReady",
    "source": "github"
  },
  "websiteUrl": "https://devready-ten.vercel.app/",
  "version": "1.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "devready-cli",
      "version": "1.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
